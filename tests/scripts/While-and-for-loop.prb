import prbtest;

probe Main
{
    Main()
    {
        var i: num = 0;
        var j: num = 0;

        while (true)
        {
            i++;
            if (i > 100)
                break;
        }

        prbtest.test("that 'i' is 101", fn()
        {
            prbtest.assert(i == 101, "'i' is " + i);
        });

        for (; j < 666; j++) {};

        prbtest.test("that 'j' is 666", fn()
        {
            prbtest.assert(j == 666, "'j' is " + j);
        })
    }
}
